{
  "name": "openchamber-muse-proxy",
  "version": "0.39.0",
  "description": "muse 分流代理状态：节点、探活、异常 + 一键换节点",
  "private": true,
  "type": "module",
  "license": "MIT",
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.7.2"
    },
    "id": "muse-proxy",
    "name": "网络代理",
    "icon": "assets/icon.svg",
    "contributes": {
      "service": {
        "entry": "service/main.js",
        "runtime": "host",
        "permissions": { "exec": ["systemctl", "python3"] }
      },
      "statusSection": {
        "entry": "status/index.html",
        "title": "网络代理",
        "height": 340
      }
    }
  },
  "scripts": {
    "build": "bunx openchamber-guest-bundle src/status/main.ts status/main.js && bunx openchamber-guest-bundle --node src/service/main.ts service/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openchamber/sdk": "2.7.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.2"
  }
}
